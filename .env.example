# vless-bank installer env — copy to .env untuk override default
# (kalau .env ada di medirana folder APP_DIR, install.sh auto-source dia)

# ---------- lokasi / repo ----------
# VLESSBANK_DIR=~/vless-bank
# VLESSBANK_REPO=https://github.com/jhopan/vless-bank

# ---------- port / listen ----------
# VLESSBANK_WEBUI_PORT=9000     # port panel web
# VLESSBANK_BASE_PORT=1081      # port SOCKS5 awal
# VLESSBANK_BASE_HTTP=0         # 0 = base+1000 (2081). manual: e.g. 2081
# VLESSBANK_LISTEN=127.0.0.1    # 0.0.0.0 = LAN+publik (wajib auth)

# ---------- auth / misc ----------
# VLESSBANK_AUTH=user:pass      # wajib kalau listen=0.0.0.0
# VLESSBANK_FORCE=0             # 1 = overwrite webui.settings.json yang sudah ada
# VLESSBANK_SKIP_BINS=0         # 1 = skip download xray/cloudflared
# VLESSBANK_START=1             # 1 = auto-start webui setelah install (0 = skip)